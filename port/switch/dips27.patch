@@ -0,0 +1,47 @@
+#pragma once
+// GOW-Port (sw-dips9): appending to a byte buffer whose lines are not in this core's cache (the GS stage's packet
+// buffers: written on the VU1 worker, read on the stage thread). Each store to such a line first reads it (write
+// allocate: from L2, the other core or DRAM); DC ZVA allocates a whole cache line as zeros without that read. Before an
+// append of n bytes at the end of a vector with the capacity for it, the lines the append will overwrite entirely are
+// zeroed this way, then the copy writes them (same bytes in the buffer: the copy overwrites every zeroed byte).
+// GOW_KICK_ZVA=0: off. A no-op off AArch64 or where DCZID_EL0 prohibits DC ZVA.
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <vector>
+
+namespace ps2_zva
+{
+#if defined(__aarch64__)
+    // the DC ZVA block size in bytes, 0 when off
+    inline uint32_t blockBytes()
+    {
+        static const uint32_t b = [] {
+            const char *e = std::getenv("GOW_KICK_ZVA");
+            if (e && e[0] == '0')
+                return 0u;
+            uint64_t d;
+            asm volatile("mrs %0, dczid_el0" : "=r"(d));
+            return (d & 16u) ? 0u : 4u << (d & 15u);
+        }();
+        return b;
+    }
+#endif
+    // call right before v.insert(v.end(), src, src + n) (or several inserts adding n bytes in all)
+    inline void prepareAppend(std::vector<uint8_t> &v, size_t n)
+    {
+#if defined(__aarch64__)
+        const uint32_t L = blockBytes();
+        if (!L || n < 2u * L || v.capacity() - v.size() < n) // (no capacity: insert reallocates, nothing to prepare)
+            return;
+        const uintptr_t b = reinterpret_cast<uintptr_t>(v.data() + v.size());
+        uintptr_t lo = (b + L - 1u) & ~static_cast<uintptr_t>(L - 1u);
+        const uintptr_t hi = (b + n) & ~static_cast<uintptr_t>(L - 1u);
+        for (; lo < hi; lo += L)
+            asm volatile("dc zva, %0" : : "r"(lo) : "memory");
+#else
+        (void)v;
+        (void)n;
+#endif
+    }
+}
