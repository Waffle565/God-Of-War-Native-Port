+// GOW-Port (sw-bugs): wall time dropped by catchUpToWall's lag bound (ns, EE thread; gow_overrides [gow-fclk])
+std::atomic<uint64_t> g_gowWallLagDroppedNs{0};
+
 uint64_t EeScheduler::catchUpToWall(uint64_t maxCycles) noexcept
 {
+    // GOW_FCLK_MAXLAG: hundredths of a field (default 1500 = 250 ms, 0 = no bound)
+    static const uint64_t maxLagCycles = [] {
+        const char *v = std::getenv("GOW_FCLK_MAXLAG");
+        return static_cast<uint64_t>(v ? std::strtoul(v, nullptr, 10) : 1500ul) * (kEeClockHz / 60u) / 100u;
+    }();
+    // GOW-Port (sw-bugs): maxLagCycles != 0 bounds the lag that is caught up at all. A host stall that blocks the EE
+    // thread itself (a synchronous screenshot write, a long GS queue drain) stops guest time while the VBlank grid's
+    // host deadlines keep their schedule; without a bound the frame clock replayed the whole stall afterwards at up to
+    // the frame cap (3.5 s stall -> 2.5x game speed for ~2 s). The part of the lag above the bound is dropped by moving
+    // the host deadlines of the grid events (VBlankStart / VBlankEnd / pacing points) later, like a pause.
+    if (maxLagCycles != 0u)
+    {
+        std::lock_guard lock(m_eventMutex);
+        const auto now = std::chrono::steady_clock::now();
+        double lagS = 0.0; // how far guest time is behind the grid's wall schedule
+        for (const ScheduledEvent &item : m_deadlines)
+        {
+            const bool grid = item.event.type == EeEventType::VBlankStart ||
+                              (item.event.type == EeEventType::ExternalWake && item.event.id == 0xFFFFFFFFu &&
+                               item.event.value == ~0ull);
+            if (!grid || item.hostDeadline > now)
+                continue;
+            const double lag = std::chrono::duration<double>(now - item.hostDeadline).count() +
+                               (static_cast<double>(item.deadlineCycle) - static_cast<double>(m_clock.eeCycle)) /
+                                   static_cast<double>(kEeClockHz);
+            lagS = std::max(lagS, lag);
+        }
+        const double maxLagS = static_cast<double>(maxLagCycles) / static_cast<double>(kEeClockHz);
+        if (lagS > maxLagS)
+        {
+            const auto shift = std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+                std::chrono::duration<double>(lagS - maxLagS));
+            for (ScheduledEvent &item : m_deadlines)
+            {
+                const bool grid = item.event.type == EeEventType::VBlankStart || item.event.type == EeEventType::VBlankEnd ||
+                                  (item.event.type == EeEventType::ExternalWake && item.event.id == 0xFFFFFFFFu &&
+                                   item.event.value == ~0ull);
+                if (grid)
+                    item.hostDeadline += shift;
+            }
+            g_gowWallLagDroppedNs.fetch_add(static_cast<uint64_t>((lagS - maxLagS) * 1e9), std::memory_order_relaxed);
+        }
+    }
     // GOW-Port (nat-spd): like catchUpToHost, but the target is the guest cycle that corresponds to the wall clock now.
     // VBlankStart and the pacing points (ExternalWake 0xFFFFFFFF) have cycle and host deadline in lockstep (the VBlank
     // grid), so a due one gives it by extrapolation: deadlineCycle + (now - hostDeadline) in cycles. That also reaches past the pending
