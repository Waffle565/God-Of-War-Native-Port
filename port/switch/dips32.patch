     using namespace GSGL;
 
+    // GOW-Port (sw-dips10): the draw shader's alpha test (alphaPasses) as a float range. The GS tests int(a) (truncated)
+    // against AREF; L <= int(a) holds exactly for a >= L when L >= 1 and for a > L - 1 when L <= 0, int(a) <= H exactly
+    // for a < H + 1 when H >= 0 and for a <= H when H <= -1, so each ATST is lo <= a <= hi with float bounds (infinite
+    // where open), NOTEQUAL and NEVER inverted. Checked against the integer test for every ATE, ATST, AREF and a.
+    struct AlphaRange
+    {
+        float lo, hi;
+        bool invert;
+    };
+    inline AlphaRange alphaTestRange(bool ate, uint32_t atst, uint32_t aref)
+    {
+        const float inf = std::numeric_limits<float>::infinity();
+        const auto atLeast = [](int l) { return l >= 1 ? static_cast<float>(l) : std::nextafter(static_cast<float>(l - 1), 0.0f); };
+        const auto atMost = [](int h) { return h >= 0 ? std::nextafter(static_cast<float>(h + 1), 0.0f) : static_cast<float>(h); };
+        const int ref = static_cast<int>(aref);
+        if (!ate)
+            return {-inf, inf, false};
+        switch (atst & 7u)
+        {
+        case 0: return {-inf, inf, true};                    // NEVER
+        case 1: return {-inf, inf, false};                   // ALWAYS
+        case 2: return {-inf, atMost(ref - 1), false};       // LESS
+        case 3: return {-inf, atMost(ref), false};           // LEQUAL
+        case 4: return {atLeast(ref), atMost(ref), false};   // EQUAL
+        case 5: return {atLeast(ref), inf, false};           // GEQUAL
+        case 6: return {atLeast(ref + 1), inf, false};       // GREATER
+        default: return {atLeast(ref), atMost(ref), true};   // NOTEQUAL
+        }
