 #define VU1N_INLINE inline __attribute__((always_inline))
 #define VU1N_NOINLINE __attribute__((noinline))
 #endif
+// GOW-Port (sw-dips7): a reference to a thread_local, opaque to the optimiser. Under -mtp=soft (the Switch) the address of
+// a thread_local is a call (__aarch64_read_tp) that GCC treats as cheap to recompute: in the large inlined run functions
+// it rematerialised `&tls` at every use instead of keeping the reference in a register (npart::run had 80 such calls,
+// one per Undo::touch site). Through this the address is an asm result: computed once, kept or spilled like any value.
+template <class T>
+inline T &vu1nOpaque(T &r)
+{
+#if defined(__GNUC__) || defined(__clang__)
+    T *p = &r;
+    __asm__("" : "+r"(p));
+    return *p;
+#else
+    return r;
+#endif
+}
