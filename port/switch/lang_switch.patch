+    // Game language (docs/settings.md "Switch"): the European disc overlays lang/<text>_<voice>.layout next to the disc
+    // (tools/lang_pack.py; in the NSP's RomFS, or sdmc:/switch/gow/disc-usa/lang for the NRO). env.txt GOW_TEXT / GOW_VOICE
+    // (en fr de it es, voice also ja) choose; otherwise the console's language: Italian, French, German, Spanish -> that
+    // language, anything else English. PS2X_DISC_OVERLAY in env.txt overrides the whole choice.
+    static const char *systemLanguageCode()
+    {
+        const char *code = "en";
+        if (R_SUCCEEDED(setInitialize()))
+        {
+            u64 languageCode = 0;
+            SetLanguage language = SetLanguage_ENUS;
+            if (R_SUCCEEDED(setGetSystemLanguage(&languageCode)) && R_SUCCEEDED(setMakeLanguage(languageCode, &language)))
+            {
+                switch (language)
+                {
+                case SetLanguage_IT: code = "it"; break;
+                case SetLanguage_FR:
+                case SetLanguage_FRCA: code = "fr"; break;
+                case SetLanguage_DE: code = "de"; break;
+                case SetLanguage_ES:
+                case SetLanguage_ES419: code = "es"; break;
+                default: break;
+                }
+            }
+            setExit();
+        }
+        return code;
+    }
+
+    static void pickLanguage()
+    {
+        if (const char *forced = std::getenv("PS2X_DISC_OVERLAY"); forced && forced[0])
+        {
+            std::fprintf(stderr, "[switch] language: PS2X_DISC_OVERLAY=%s (env.txt)\n", forced);
+            return;
+        }
+        const char *system = systemLanguageCode();
+        const char *text = std::getenv("GOW_TEXT");
+        const char *voice = std::getenv("GOW_VOICE");
+        if (!text || !text[0])
+            text = system;
+        if (!voice || !voice[0])
+            voice = text;
+        char layout[64];
+        std::snprintf(layout, sizeof(layout), "lang/%s_%s.layout", text, voice);
+        // next to the disc main.cpp boots (the RomFS one when the title carries it, else the SD card's), else in
+        // sdmc:/switch/gow/lang/ (copied there when the installed NSP predates the language packs)
+        const char *disc = access("romfs:/disc-usa/SCUS_973.99", F_OK) == 0 ? "romfs:/disc-usa/" : "sdmc:/switch/gow/disc-usa/";
+        char path[160];
+        std::snprintf(path, sizeof(path), "%s%s", disc, layout);
+        const char *chosen = nullptr;
+        if (access(path, F_OK) == 0)
+            chosen = layout; // relative to the disc folder
+        else
+        {
+            std::snprintf(path, sizeof(path), "sdmc:/switch/gow/%s", layout);
+            if (access(path, F_OK) == 0)
+                chosen = path; // a device path: disc_source takes it as absolute
+        }
+        if (chosen)
+        {
+            setenv("PS2X_DISC_OVERLAY", chosen, 1);
+            setenv("GOW_TEXT", text, 1);
+            setenv("GOW_VOICE", voice, 1);
+        }
+        std::fprintf(stderr, "[switch] language: system %s, text %s, voice %s -> %s%s\n", system, text, voice, path,
+                     chosen ? "" : " (missing: plain USA disc, English)");
+    }
