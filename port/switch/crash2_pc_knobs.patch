+// sw-crash2 diagnostics (docs/diagnostics.md "EE crash diagnostics").
+// gowCrashExtra: on the first guest crash report, all GPRs, the branch ring and (GOW_CRASH_DUMP=<path prefix>) the 32 MB
+// EE RAM to <prefix>_<why>.bin.
+static double gowDiagSeconds()
+{
+    static const auto start = std::chrono::steady_clock::now();
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+}
+static PS2Runtime *g_gowDiagRuntime = nullptr; // for the IOP RAM dump
+// With GOW_POOL_CHECK: the last 65536 guest branches {src, dst, ra} (EE thread only), dumped with the RAM to
+// <prefix>_<why>_ring.bin (u32 position, then 65536 records of 3 u32, oldest at position & 0xFFFF).
+static uint32_t g_gowBigRing[65536][3];
+static uint32_t g_gowBigRingPos = 0;
+static void gowDumpRam(uint8_t *rdram, const char *why)
+{
+    static const char *prefix = std::getenv("GOW_CRASH_DUMP");
+    static int dumps = 0;
+    if (!prefix || !rdram || dumps >= 3)
+        return;
+    ++dumps;
+    if (std::FILE *file = std::fopen((std::string(prefix) + "_" + why + "_ring.bin").c_str(), "wb"))
+    {
+        std::fwrite(&g_gowBigRingPos, 4, 1, file);
+        std::fwrite(g_gowBigRing, 1, sizeof(g_gowBigRing), file);
+        std::fclose(file);
+    }
+    const std::string path = std::string(prefix) + "_" + why + ".bin";
+    if (std::FILE *file = std::fopen(path.c_str(), "wb"))
+    {
+        std::fwrite(rdram, 1, PS2_RAM_SIZE, file);
+        std::fclose(file);
+        std::fprintf(stderr, "[gow-crash] EE RAM dumped to %s\n", path.c_str());
+    }
+    else
+        std::fprintf(stderr, "[gow-crash] cannot write %s\n", path.c_str());
+    if (g_gowDiagRuntime)
+    {
+        std::vector<uint8_t> iop(0x200000u);
+        if (g_gowDiagRuntime->readIopMemory(0u, iop.data(), iop.size()))
+            if (std::FILE *file = std::fopen((std::string(prefix) + "_" + why + "_iop.bin").c_str(), "wb"))
+            {
+                std::fwrite(iop.data(), 1, iop.size(), file);
+                std::fclose(file);
+            }
+    }
+}
+void gowCrashExtra(uint8_t *rdram, R5900Context *ctx, const char *why)
+{
+    if (ctx)
+    {
+        std::string line = "[gow-crash] " + std::string(why) + " t=" + std::to_string(gowDiagSeconds()) + " gpr:";
+        for (int i = 1; i < 32; ++i)
+        {
+            char buf[24];
+            std::snprintf(buf, sizeof buf, " %d=%x", i, (uint32_t)_mm_cvtsi128_si32(ctx->r[i]));
+            line += buf;
+        }
+        std::fprintf(stderr, "%s\n", line.c_str());
+    }
+    if (rdram)
+    {
+        // GoW: player controller *0x29CD58 (its +0 = player object) and pool *0x29C708 (0x24-byte nodes).
+        auto rd = [rdram](uint32_t a) { uint32_t v = 0; a &= 0x01FFFFFCu; std::memcpy(&v, rdram + a, 4); return v; };
+        const uint32_t g = rd(0x29CD58u) & 0x01FFFFFFu;
+        std::fprintf(stderr, "[gow-crash] ctl=%x [%x %x %x %x] low[c0]=%x %x %x %x %x state=%u levelReady=%u pool=%x head=%x\n",
+                     g, rd(g), rd(g + 4), rd(g + 8), rd(g + 12), rd(0xC0), rd(0xC4), rd(0xC8), rd(0xCC), rd(0xD0),
+                     rd(0x29E560u), rd(0x29E584u), rd(0x29C708u), rd((rd(0x29C708u) & 0x01FFFFFFu) + 0x10u));
+    }
+    std::fflush(stderr);
+    gowDumpBranchRing(why);
+    gowDumpRam(rdram, why);
+    std::fflush(stderr);
+}
+// GOW_POOL_CHECK=1: checks the game's 0x24-byte node pool (*0x29C708; alloc 0x13DA10, free 0x13DB18; free list at
+// pool+0x10, link at block+0). At every alloc/free the first 256 free entries must be blocks of the pool and a freed
+// block must be a block that is not free already; every 2 ms (checked at guest calls) the whole free list is walked
+// (blocks of the pool, no cycle). The first faults are logged with the branch ring (and RAM dumps with
+// GOW_CRASH_DUMP); every 5 s [gow-pool] gives the free count. GOW_POOL_LOG=1 also logs every alloc/free.
+static void gowPoolCheck(uint8_t *rdram, R5900Context *ctx, uint32_t targetPc)
+{
+    const bool op = targetPc == 0x13DA10u || targetPc == 0x13DB18u;
+    static double nextWalk = 0;
+    static uint32_t calls = 0;
+    if (!op && ((++calls & 0xFFu) != 0u || gowDiagSeconds() < nextWalk))
+        return;
+    auto rd = [rdram](uint32_t a) { uint32_t v = 0; a &= 0x01FFFFFCu; std::memcpy(&v, rdram + a, 4); return v; };
+    const uint32_t pool = rd(0x29C708u) & 0x01FFFFFFu;
+    if (pool < 0x100000u || (op && pool != ((uint32_t)_mm_cvtsi128_si32(ctx->r[4]) & 0x01FFFFFFu)))
+        return;
+    uint16_t align = 0, grow = 0;
+    std::memcpy(&align, rdram + pool + 0xC, 2);
+    std::memcpy(&grow, rdram + pool + 0xE, 2);
+    const uint32_t size = rd(pool + 8u);
+    if (align == 0u || size == 0u || grow != 0u)
+        return;
+    const uint32_t first = pool + 0x18u + (align - (pool + 0x18u) % align) % align;
+    const uint32_t limit = first + size * 8192u;
+    auto valid = [&](uint32_t p) { return p >= first && p < limit && p < 0x02000000u && (p - first) % size == 0u; };
+    static int faults = 0;
+    static double nextCount = 0;
+    static const bool opLog = [] { const char *v = std::getenv("GOW_POOL_LOG"); return v && v[0] == '1'; }();
+    const double now = gowDiagSeconds();
+    const uint32_t block = (uint32_t)_mm_cvtsi128_si32(ctx->r[5]);
+    const char *fault = nullptr;
+    uint32_t bad = 0, index = 0, from = 0;
+    if (op)
+    {
+        if (opLog)
+            std::fprintf(stderr, "[gow-pool-op] %s block=%x head=%x ra=%x t=%.3f state=%u\n", targetPc == 0x13DA10u ? "alloc" : "free",
+                         targetPc == 0x13DA10u ? rd(pool + 0x10u) : block, rd(pool + 0x10u),
+                         (uint32_t)_mm_cvtsi128_si32(ctx->r[31]), now, rd(0x29E560u));
+        if (targetPc == 0x13DB18u && !valid(block))
+            fault = "free of a non-block", bad = block;
+        uint32_t p = rd(pool + 0x10u), prev = pool + 0x10u;
+        for (uint32_t i = 0; !fault && p != 0u && i < 256u; ++i, prev = p, p = rd(p))
+        {
+            if (!valid(p))
+                fault = "bad free-list entry", bad = p, index = i, from = prev;
+            else if (targetPc == 0x13DB18u && p == block)
+                fault = "double free", bad = p, index = i, from = prev;
+        }
+    }
+    else
+    {
+        nextWalk = now + 0.002;
+        static const double selftest = std::getenv("GOW_POOL_SELFTEST") ? std::atof(std::getenv("GOW_POOL_SELFTEST")) : -1.0;
+        static bool poked = false;
+        if (selftest >= 0.0 && now >= selftest && !poked)
+        {
+            poked = true;
+            uint32_t q = rd(pool + 0x10u);
+            for (int k = 0; k < 100 && q; ++k) q = rd(q);
+            if (q) { uint32_t v = 0xC8u; std::memcpy(rdram + q, &v, 4); std::fprintf(stderr, "[gow-pool] selftest: link of %x set to c8\n", q); }
+        }
+        uint32_t p = rd(pool + 0x10u), prev = pool + 0x10u, i = 0;
+        for (; p != 0u && i < 8192u; ++i, prev = p, p = rd(p))
+            if (!valid(p))
+            {
+                fault = "bad free-list entry (walk)", bad = p, index = i, from = prev;
+                break;
+            }
+        if (!fault && i >= 8192u)
+            fault = "free-list cycle (walk)", bad = p, index = i;
+    }
+    // state 4 (loading screen): words of 0x21E410 (stage 0x29E580, levelReady 0x29E584, load handle 0x29E550/54),
+    // zone loaded 0x29CAB4, pad words 0x29E574 / 0x29E5A0, printed when one changes
+    if (!op && rd(0x29E560u) == 4u)
+    {
+        static uint32_t last[7] = {~0u};
+        const uint32_t words[7] = {rd(0x29E580u), rd(0x29E584u), rd(0x29E550u), rd(0x29E554u), rd(0x29CAB4u), rd(0x29E574u), rd(0x29E5A0u)};
+        if (std::memcmp(words, last, sizeof(words)) != 0)
+        {
+            std::memcpy(last, words, sizeof(words));
+            std::fprintf(stderr, "[gow-load] t=%.2f stage=%x levelReady=%x handle=%x/%x zoneLoaded=%x pending=%x 5a0=%x\n", now,
+                         words[0], words[1], words[2], words[3], words[4], words[5], words[6]);
+        }
+    }
+    if (now >= nextCount)
+    {
+        nextCount = now + 5.0;
+        uint32_t n = 0;
+        for (uint32_t q = rd(pool + 0x10u); q != 0u && valid(q) && n < 9000u; q = rd(q))
+            ++n;
+        std::fprintf(stderr, "[gow-pool] t=%.1f pool=%x first=%x size=%x free=%u state=%u levelReady=%u\n", now, pool, first,
+                     size, n, rd(0x29E560u), rd(0x29E584u));
+    }
+    if (fault && faults < 4)
+    {
+        ++faults;
+        std::fprintf(stderr, "[gow-pool] FAULT %s: %s block=%x bad=%x index=%u link-at=%x head=%x fn=%x ra=%x t=%.2f state=%u\n",
+                     op ? (targetPc == 0x13DA10u ? "alloc" : "free") : "walk", fault, op ? block : 0u, bad, index, from,
+                     rd(pool + 0x10u), targetPc, (uint32_t)_mm_cvtsi128_si32(ctx->r[31]), now, rd(0x29E560u));
+        if (faults == 1)
+            gowCrashExtra(rdram, ctx, "pool");
+    }
+}
