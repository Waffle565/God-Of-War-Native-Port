+    // sw-dips7: one code key while the micro memory changes. The game uploads modules into the micro memory hundreds of
+    // times a second and its contents rarely repeat (the recordings: ~45 distinct images in 51 swaps), so the old
+    // canonical images (four, compared and copied whole: 16 KB memcmp + 16 KB memcpy per swap) and every cache keyed by
+    // them missed on almost every swap. Now a swap with a known changed range [lo, hi) keeps the key and drops only
+    // what reads those bytes (entry / loop kinds near them, the coarse hashes and isProgram's slot when their ranges
+    // overlap); an unknown range starts a new key (raw, unique: the generations only grow).
+    namespace nrun
+    {
+        struct CodeTrack
+        {
+            uint64_t raw = 0, key = 0;
+        };
+        inline CodeTrack &codeTrack()
+        {
+            thread_local CodeTrack t;
+            return t;
+        }
