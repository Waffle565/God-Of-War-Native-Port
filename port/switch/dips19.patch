+    inline uint64_t trackGen(const uint8_t *code, uint64_t raw, bool ranged, uint32_t lo, uint32_t hi)
+    {
+        nrun::CodeTrack &t = nrun::codeTrack();
+        if (t.key && raw == t.raw)
+            return t.key;
+        if (!t.key || !ranged)
+            t.key = raw;
+        else if (lo < hi)
+        {
+            nrun::invalidateCodeInfo(t.key, code, lo, hi);
