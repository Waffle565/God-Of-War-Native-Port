+    // ---- image chunks (see State::imageChunks) ----------------------------------------------------------------------
+    static constexpr uint32_t kImageChunk = 32u << 20, kImageDedicated = 8u << 20;
+
+    bool imageAlloc(uint32_t size, uint32_t alignment, int32_t &chunk, uint32_t &off)
+    {
+        alignment = std::max(alignment, 256u);
+        for (size_t c = 0; c <= s->imageChunks.size(); ++c)
+        {
+            if (c == s->imageChunks.size())
+            {
+                State::ImageChunk n;
+                n.mem = makeMem(kImageChunk, DkMemBlockFlags_GpuCached | DkMemBlockFlags_Image);
+                if (!n.mem)
+                    return false;
+                n.size = kImageChunk;
+                n.free[0] = kImageChunk;
+                s->imageChunks.push_back(std::move(n));
+            }
+            State::ImageChunk &ch = s->imageChunks[c];
+            if (ch.size - ch.used < size)
+                continue;
+            for (auto it = ch.free.begin(); it != ch.free.end(); ++it)
+            {
+                const uint32_t lo = it->first, hi = it->first + it->second, at = align(lo, alignment);
+                if (at > hi || hi - at < size)
+                    continue;
+                ch.free.erase(it);
+                if (at > lo)
+                    ch.free[lo] = at - lo;
+                if (at + size < hi)
+                    ch.free[at + size] = hi - (at + size);
+                ch.used += size;
+                chunk = static_cast<int32_t>(c);
+                off = at;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    void imageFree(int32_t chunk, uint32_t off, uint32_t len)
+    {
+        State::ImageChunk &ch = s->imageChunks[static_cast<size_t>(chunk)];
+        ch.used -= len;
+        auto it = ch.free.emplace(off, len).first;
+        auto next = std::next(it);
+        if (next != ch.free.end() && it->first + it->second == next->first)
+        {
+            it->second += next->second;
+            ch.free.erase(next);
+        }
+        if (it != ch.free.begin())
+        {
+            auto prev = std::prev(it);
+            if (prev->first + prev->second == it->first)
+            {
+                prev->second += it->second;
+                ch.free.erase(it);
+            }
+        }
+    }
